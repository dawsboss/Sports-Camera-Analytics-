	(text "Sideline camera hub, rev A. Plugs into Antmicro's Jetson Orin Baseboard J7 (J1 here) and J8 (J2 here)."
		(exclude_from_sim no)
		(at 20 520 0)
		(effects
			(font (size 2 2))
			(justify left bottom)
		)
		(uuid "77ac76c7-69e0-5fd9-aa37-b8a997a8fa48")
	)
	(text "Baseboard stuffing for four 2-lane cameras: fit R122, remove R108 (CSI3 lanes to J8). Fit R4/R5 only if J2's GPIOs are wanted."
		(exclude_from_sim no)
		(at 20 526 0)
		(effects
			(font (size 2 2))
			(justify left bottom)
		)
		(uuid "3d8d6b24-2647-5abf-ae1f-d8fcd0b14832")
	)
	(text "FFC: 50-pin 0.5 mm, pin N to pin N, as Antmicro's own camera boards use. Camera ports follow the Raspberry Pi 5 22-pin pinout."
		(exclude_from_sim no)
		(at 20 532 0)
		(effects
			(font (size 2 2))
			(justify left bottom)
		)
		(uuid "a6a8e700-7656-52e0-81eb-de32cd427aa5")
	)
	(text "Sync: SN74AVC4T774 DIR high = bus to head (slave), low = head to bus (master). PCA9555 pull-ups start every head powered,"
		(exclude_from_sim no)
		(at 20 538 0)
		(effects
			(font (size 2 2))
			(justify left bottom)
		)
		(uuid "92f71a74-fc67-5d3c-a9d1-03daba5c2cc2")
	)
	(text "enabled and isolated (OE high). Software sets one master (or none, with an external source on J3), then clears OE."
		(exclude_from_sim no)
		(at 20 544 0)
		(effects
			(font (size 2 2))
			(justify left bottom)
		)
		(uuid "0961254c-c3eb-5bae-bbb4-9698f6146244")
	)
	(text "I2C (via the baseboard's mux): FAR-L bus has U1 PCA9555 0x20, U10 ICM-42688-P 0x69, U11 SHT45 0x44; FAR-R bus has U2 PCA9555 0x20."
		(exclude_from_sim no)
		(at 20 550 0)
		(effects
			(font (size 2 2))
			(justify left bottom)
		)
		(uuid "6a5229cc-67ae-5cd2-805f-be1b67d2746d")
	)
